# Copy to apps/api/.env and apps/web/.env.local — never commit real secrets.

# --- API (apps/api/.env) ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://mealmate:mealmate@localhost:5432/mealmate?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters-long-secret
CORS_ORIGINS=http://localhost:3000
ADMIN_BOOTSTRAP_EMAIL=admin@mealmate.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe-Admin-2026!
PRIVATE_STORAGE_DIR=./storage/private

# --- Web (apps/web/.env.local) ---
API_BASE_URL=http://localhost:4000
