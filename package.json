{
  "name": "mealmate",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@mealmate/api",
    "dev:web": "npm run dev --workspace=web",
    "dev:mobile": "npm run start --workspace=@mealmate/mobile",
    "dev:mobile:web": "npm run web --workspace=@mealmate/mobile",
    "build": "npm run build --workspace=@mealmate/api && npm run build --workspace=web",
    "lint": "npm run lint --workspace=@mealmate/api && npm run lint --workspace=web",
    "db:migrate": "npm run prisma:migrate --workspace=@mealmate/api",
    "db:seed": "npm run db:seed --workspace=@mealmate/api"
  }
}
